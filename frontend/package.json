{
    "name": "ftr-frontend",
    "description": "ft_transcendence frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host",
        "build": "tsc -b && vite build",
        "type-check": "tsc -b ../common/tsconfig.json && tsc --noEmit",
        "type-check:watch": "tsc -b ../common/tsconfig.json && tsc --noEmit --watch",
        "lint": "eslint .",
        "lint-fix": "eslint . --fix",
        "preview": "vite preview",
        "server": "node src/js/server.js"
    },
    "dependencies": {
        "@ant-design/icons": "^6.3.2",
        "common": "*",
        "antd": "^6.5.3",
        "axios": "^1.19.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "socket.io": "^4.8.3",
        "socket.io-client": "^4.8.3",
        "three": "^0.184.0"
    },
    "devDependencies": {
        "@types/axios": "^0.9.36",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.6.0",
        "vite": "^8.0.12"
    }
}
