{
    "name": "eventlog-service",
    "description": "ft_transcendence eventlog service",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "NODE_ENV=development tsx watch src/main.ts",
        "build": "tsc -b",
        "type-check": "tsc -b ../../../common/tsconfig.json && tsc --noEmit",
        "type-check:watch": "tsc -b ../../../common/tsconfig.json && tsc --noEmit --watch",
        "lint": "eslint .",
        "lint-fix": "eslint . --fix",
        "start": "NODE_ENV=production tsx src/main.ts"
    },
    "dependencies": {
        "common": "*",
        "dotenv": "^17.4.2",
        "express": "^5.1.0",
        "pg": "^8.23.0",
        "typeorm": "^1.1.0",
        "express-validator": "^7.3.2",
        "tslog": "^5.1.0"
    }
}
