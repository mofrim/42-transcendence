{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "connection-service",
    "description": "ft_transcendence connection-service",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "NODE_ENV=development tsx watch src/main.ts",
        "dev-win": "set NODE_ENV=development&& tsx watch src/main.ts",
        "build": "tsc -b",
        "type-check": "tsc -b ../../../ftr-common/tsconfig.json && tsc --noEmit",
        "type-check:watch": "tsc -b ../../../ftr-common/tsconfig.json && tsc --noEmit --watch",
        "lint": "eslint .",
        "lint-fix": "eslint . --fix",
        "start": "NODE_ENV=production node ../../dist/conn-service/main.js"
    },
    "dependencies": {
        "dotenv": "^17.4.2"
    }
}
