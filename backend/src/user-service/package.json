{
    "name": "user-service",
    "description": "ft_transcendence user-service",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "NODE_ENV=development tsx watch userProfile/src/main.ts",
        "build": "tsc -b",
        "type-check": "tsc -b ../../../ftr-common/tsconfig.json && tsc --noEmit",
        "type-check:watch": "tsc -b ../../../ftr-common/tsconfig.json && tsc --noEmit --watch",
        "lint": "eslint .",
        "lint-fix": "eslint . --fix",
        "start": "NODE_ENV=production node ../../dist/user-service/main.js"
    },
    "dependencies": {
        "dotenv": "^17.4.2",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.22.0",
        "reflect-metadata": "^0.2.2",
        "typeorm": "^1.1.0"
    },
    "devDependencies": {
        "@types/dotenv": "^6.1.1",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/pg": "^8.20.3"
    }
}
