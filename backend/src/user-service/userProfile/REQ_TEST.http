@baseUrl = http://localhost:3002
@userId = 101

### 1. Create user profile
POST {{baseUrl}}/api/user-profiles
Content-Type: application/json

{
  "userId": {{userId}},
  "character": true
}

### 2. Get user profile by user ID
GET {{baseUrl}}/api/user-profiles/{{userId}}

### 3. Update user profile
PUT {{baseUrl}}/api/user-profiles/{{userId}}
Content-Type: application/json

{
  "character": false
}

### 4. Delete user profile
DELETE {{baseUrl}}/api/user-profiles/{{userId}}

### 5. Verify delete (should return 404)
GET {{baseUrl}}/api/user-profiles/{{userId}}
