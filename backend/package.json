{
    "name": "ftr-backend",
    "description": "ft_transcendence backend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -b",
        "type-check": "tsc -b ../common/tsconfig.json && tsc --noEmit",
        "type-check:watch": "tsc -b ../common/tsconfig.json && tsc --noEmit --watch",
        "lint": "eslint .",
        "lint-fix": "eslint . --fix",
        "server": "node dist/server.js"
    },
    "dependencies": {
        "@common/types": "*",
        "express": "^5.2.1",
        "socket.io": "^4.8.3"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "tsx": "^4.23.1"
    }
}
